manifest {
    name            = 'nf-austin/infercnv'
    author          = 'Austin Varela'
    homePage        = 'https://github.com/nf-austin/infercnv'
    description     = 'Automated InferCNV pipeline with clustering, CIN scoring, and matrix concatenation'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.2.0'
    defaultBranch   = 'main'
}

params {
    // Input/Output
    h5ad_dir   = "data/*.h5ad"
    outdir     = "results"

    // Reference resolution
    species    = "human"
    release    = "114"

    // Clustering / InferCNV
    resolution = 1.0
    cutoff     = 0.1

    // Resource caps (applied via process.resourceLimits below). Use Nextflow
    // unit literals (.GB, .h) so values stay typed as MemoryUnit / Duration.
    max_memory = 128.GB
    max_cpus   = 32
    max_time   = 72.h
}

process {
    // Nextflow 24.04+ enforces these caps automatically on every task.
    resourceLimits = [
        memory: params.max_memory,
        cpus  : params.max_cpus,
        time  : params.max_time
    ]

    withName: 'PREPARE_REFERENCE' {
        cpus   = 2
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'CLUSTER_CELLS|ANNOTATE_H5AD|CONCAT_H5ADS' {
        cpus          = { 4 * task.attempt }
        memory        = { 16.GB * task.attempt }
        time          = { 2.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withName: 'RUN_INFERCNV' {
        cpus          = { 16 * task.attempt }
        memory        = { 64.GB * task.attempt }
        time          = { 24.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

profiles {
    docker {
        docker.enabled       = true
        docker.userEmulation = true
        conda.enabled        = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = true
    }
    conda {
        conda.enabled = true
    }
}